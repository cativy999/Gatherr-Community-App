# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Ideogram image generation
VITE_IDEOGRAM_KEY=your_ideogram_key_here

# Anthropic (server-side only, not exposed to browser)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Site URL — used for share links, OG tags, and API redirects (no trailing slash)
VITE_SITE_URL=https://www.joinbeyondsunday.app
SITE_URL=https://www.joinbeyondsunday.app

# PostHog analytics (leave blank to disable analytics in that environment)
VITE_POSTHOG_KEY=phc_your_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com
