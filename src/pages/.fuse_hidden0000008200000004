// ── Timezone abbreviation map ──────────────────────────────────────────────
const TZ_ABBR: Record<string, string> = {
  "America/Los_Angeles": "PT",
  "America/Denver":      "MT",
  "America/Phoenix":     "MT",
  "America/Chicago":     "CT",
  "America/New_York":    "ET",
  "America/Anchorage":   "AKT",
  "Pacific/Honolulu":    "HT",
};
const getTzAbbr = (tz: string | null | undefined) => tz ? (TZ_ABBR[tz] ?? "") : "";

const formatTime = (t: string) =>
  new Date(`2000-01-01T${t}`).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });

const getEventTime = (event: any) => {
  const t = event.start_time ?? event.time;
  if (!t) return null;
  const base = formatTime(t);
  const tz = getTzAbbr(event.timezone);
  return tz ? `${base} ${tz}` : base;
};

// ── Group events by date key ───────────────────────────────────────────────
const groupByDate = (events: any[]) => {
  const sorted = [...events].sort((a, b) => {
    if (a.date !== b.date) return a.date.localeCompare(b.date);
    return (a.time ?? "").localeCompare(b.time ?? "");
  });
  const groups: { key: string; label: string; dayOfWeek: string; events: any[] }[] = [];
  const seen = new Map<string, number>();
  sorted.forEach((ev) => {
    const [y, m, d] = ev.date.split("-").map(Number);
    const date = new Date(y, m - 1, d);
    const label = date.toLocaleDateString("en-US", { month: "long", day: "numeric" });
    const dayOfWeek = date.toLocaleDateString("en-US", { weekday: "long" });
    const key = ev.date;
    if (seen.has(key)) {
      groups[seen.get(key)!].events.push(ev);
    } else {
      seen.set(key, groups.length);
      groups.push({ key, label, dayOfWeek, events: [ev] });
    }
  });
  return groups;
};

